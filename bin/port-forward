set -e

if [ -z "$2" ]; then
  echo "Forward your local port to remote destination, can support docker containers." >&2
  echo "Incorrect param number; $0 [IP|HOSTNAME] [DESTINATION PORT|CONTAINER]" >&2
  exit 1
fi

DESTINATION="$1"
DESTINATION_PORT="$2"
LOCAL_PORT="$3"
LOCAL_ADDR="127.0.0.1"

if [ "$DESTINATION_PORT" -eq "$DESTINATION_PORT" ] 2> /dev/null; then
  NMAP_IPS=$(ssh $DESTINATION ip -json a s | jq -r '.[] | .addr_info | .[] | select(.family == "inet") | .local')
  CNI_IPS=$(ssh $DESTINATION "find /var/run/cni/ -type f -printf '%f\n' | grep '^[0-9.]*$'" || true)
  REMOTE_IPS="$NMAP_IPS $CNI_IPS"
  OPENED_ADDR=$(ssh $DESTINATION nmap -oG - -p $DESTINATION_PORT $REMOTE_IPS | grep '/open/' | cut -d' ' -f 2 | head -n 1)
elif [ -n "$(echo $DESTINATION_PORT | cut -d':' -f 2)" ]; then
  OPENED_ADDR="$(echo $DESTINATION_PORT | cut -d':' -f 1)"
  DESTINATION_PORT="$(echo $DESTINATION_PORT | cut -d':' -f 2)"
fi

if [ -n "$(echo $OPENED_ADDR | grep -o [a-zA-Z])" ]; then
  CONTAINER_NAME="$OPENED_ADDR"
  OPENED_ADDR="$(ssh $DESTINATION "docker container inspect $CONTAINER_NAME" 2>/dev/null | jq -r '.[] | .NetworkSettings | .Networks |  .[] | .IPAddress | select(length > 0)')"
  
  if [ -z ${OPENED_ADDR} ]; then
    NEW_CONTAINER_NAME="$(ssh $DESTINATION "docker container ls --filter 'Name = $CONTAINER_NAME' --format '{{ .Names }}'" | head -n 1)"
    OPENED_ADDR="$(ssh $DESTINATION "docker container inspect $NEW_CONTAINER_NAME" | jq -r '.[] | .NetworkSettings | .Networks |  .[] | .IPAddress | select(length > 0)')"
    echo -e "\e[3mDid not find container \e[3;33m$CONTAINER_NAME\e[3;0m, I will use \e[3;33m$NEW_CONTAINER_NAME\e[0m\n" >&2
    CONTAINER_NAME=$NEW_CONTAINER_NAME
  fi

  if [ -n "$(echo $DESTINATION_PORT | grep -o [a-zA-Z])" ] && [ -n "$OPENED_ADDR" ]; then
    DESTINATION_PORT="$(ssh $DESTINATION "docker container inspect $CONTAINER_NAME" | jq -r '.[] | .Config | .ExposedPorts | keys | .[] | select(test(. = "/tcp"))' | head -n 1 | cut -d'/' -f 1)"
    echo -e "\e[3mNo port provided for container \e[3;33m$CONTAINER_NAME\e[3;0m, I will use first exposed port \e[3;33m$DESTINATION_PORT\e[0m\n" >&2
  else
    OPENED_ADDR="$DESTINATION_PORT"
  fi
fi

if [ -z "$OPENED_ADDR" ]; then
  echo "No address listening on port $DESTINATION_PORT found" >&2
  if [ -n "$CONTAINER_NAME" ]; then
    echo "Could not find container $CONTAINER_NAME" >&2
  else
    echo "Searched addresses are $(echo $REMOTE_IPS | tr ' ' ';')" >&2
  fi
  exit 1
fi

if [ -z "$LOCAL_PORT" ]; then
  LOCAL_PORT="$DESTINATION_PORT"
elif [ -n "$(echo $LOCAL_PORT | cut -d':' -f 2 -s)" ]; then
  LOCAL_ADDR="$(echo $LOCAL_PORT | cut -d':' -f 1)"
  LOCAL_PORT="$(echo $LOCAL_PORT | cut -d':' -f 2)"
elif [ -n "$(echo $LOCAL_PORT | grep -oE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')" ] 2> /dev/null; then
  LOCAL_ADDR="$LOCAL_PORT"
  LOCAL_PORT="$DESTINATION_PORT"
fi

echo -e "\e[1;35mConnecting to\e[0m $DESTINATION and forwarding remote \e[1;33m$OPENED_ADDR:$DESTINATION_PORT\e[0m to local \e[1;36m$LOCAL_ADDR:$LOCAL_PORT\e[0m"

ssh -N -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=no -L "$LOCAL_ADDR:$LOCAL_PORT:${OPENED_ADDR}:$DESTINATION_PORT" $DESTINATION
