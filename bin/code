set -e

arg="${1%/}"
file="$arg/$(basename $arg).code-workspace"

if [ -d "$arg" ] && [ -f "$file" ]; then
  echo "Workspace $arg found in directory $arg"
  code_args="$file"
elif [ -d "$HOME/$arg" ] && [ -f "$HOME/$file" ]; then
  echo "Workspace $arg found in HOME's directory $arg"
  code_args="$HOME/$file"
elif [ -d "$HOME/.local/share/vscode" ] && [ -f "$HOME/.local/share/vscode/$arg.code-workspace" ]; then
  echo "Workspace $arg found in Code's directory"
  code_args="$HOME/.local/share/vscode/$arg.code-workspace"
else
  echo "Workspace not found"
  code_args=$@
fi

echo "Will open $code_args"
exec /usr/bin/code $code_args
